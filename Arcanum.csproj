<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Arcanum</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine libraries live in their own projects; keep them out of the Godot assembly glob. -->
    <Compile Remove="src/**" />
    <Compile Remove="tests/**" />
    <None Remove="src/**;tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Arcanum.Engine/Arcanum.Engine.csproj" />
    <ProjectReference Include="src/Arcanum.Cards/Arcanum.Cards.csproj" />
    <ProjectReference Include="src/Arcanum.Data/Arcanum.Data.csproj" />
    <ProjectReference Include="src/Arcanum.Bots/Arcanum.Bots.csproj" />
    <ProjectReference Include="src/Arcanum.Net/Arcanum.Net.csproj" />
  </ItemGroup>
  <!-- Internet lobbies and relayed connections: only when the Epic Online Services SDK is next to the repository (see docs/online-services.md). -->
  <PropertyGroup>
    <EosSdkDir Condition="'$(EosSdkDir)' == ''">$(MSBuildThisFileDirectory)../eos-sdk/SDK</EosSdkDir>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(EosSdkDir)/Source/Core/Common.cs')">
    <DefineConstants>$(DefineConstants);ARCANUM_EOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EosSdkDir)/Source/Core/Common.cs')">
    <ProjectReference Include="src/Arcanum.EosSdk/Arcanum.EosSdk.csproj" />
  </ItemGroup>
</Project>
