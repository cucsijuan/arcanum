# /etc/caddy/Caddyfile: HTTPS (certificate from Let's Encrypt) in front of the career service.
arcanum-career.duckdns.org {
	encode gzip
	request_body {
		max_size 4MB
	}
	# The season files (publish-season.sh puts them there), served as they are; clients ask only for changes.
	handle /career/season/* {
		root * /srv/arcanum-career
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:5080
	}
}
